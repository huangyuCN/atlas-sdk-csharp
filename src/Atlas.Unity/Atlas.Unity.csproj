<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Atlas.Unity</RootNamespace>
    <AssemblyName>Atlas.Unity</AssemblyName>
    <!-- 适配薄层零 UnityEngine 编译依赖：纯 API 层，Unity 主线程同步上下文由
         宿主（Unity 侧代码）在运行时注入——不引用 UnityEngine 程序集，
         保证可在纯 .NET 工具链编译、单测可跑。 -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Atlas/Atlas.csproj" />
  </ItemGroup>
</Project>
